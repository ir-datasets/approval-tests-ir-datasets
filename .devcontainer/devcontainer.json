{
  "name": "approval-tests-ir-datasets",
  "image": "ghcr.io/ir-datasets/approval-tests-ir-datasets:0.0.1-dev",
  "workspaceFolder": "/workspaces/approval-tests-ir-datasets",
  // The Docker socket and /tmp are bind-mounted in so PyTerrierIndexVerifier's
  // "tira-cli run local" can start sibling containers on the host: those
  // containers need bind-mount sources (the persisted documents, the index
  // output) that resolve to the same path both here and on the Docker host.
  // /tmp is a simple, generally host-writable path both engines share (unlike
  // "/workspaces/...", which has no host equivalent e.g. with Docker Desktop).
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/tmp,target=/tmp,type=bind"
  ],
  // Host networking: lets e.g. approval_server.py's "localhost:<port>" (see
  // the "Approve"/"Deny" HTML report server) be reached directly from the
  // host's own browser, with no explicit port-forwarding configuration.
  "runArgs": ["--network=host"],
  // Approval test results and artifacts (e.g. the built PyTerrier index) are
  // stored under "<IR_DATASETS_HOME>/approvals". Pointing it at /tmp keeps
  // that directory host-visible, which PyTerrierIndexVerifier relies on.
  "remoteEnv": {
    "IR_DATASETS_HOME": "/tmp/.ir_datasets",
    // Like IR_DATASETS_HOME above, kept under the host-visible /tmp mount
    // (rather than the default "~/.tira") so it is writable regardless of
    // which user the container runs as.
    "TIRA_CACHE_DIR": "/tmp/.tira"
  },
  // GitHub Codespaces always sets CODESPACES=true inside the container at
  // runtime (it is unset for a plain local devcontainer/docker run); only
  // there is /tmp too small/ephemeral for Docker bind-mounts to work, so TIRA
  // (via "tira-cli run local") needs TIRA_DOCKER_TMPDIR pointed at the larger
  // disk Codespaces mounts at /mnt/containerTmp instead. TMPDIR itself is
  // left alone since it already defaults to /tmp.
  //
  // Writing this conditionally to a shell startup file (so it reaches
  // Jupyter kernels too, not just postStartCommand's own subshell) turned
  // out not to reliably apply in time -- this is instead set from Python
  // itself (see
  // "approval_tests_ir_datasets._configure_tira_docker_tmpdir_for_codespaces",
  // called at the top of every IrDatasetsApprovalTest.verify() call),
  // which works regardless of which shell (if any) started the process.
  //
  // Install the local package, then verify the TIRA client is set up
  // correctly in this container ("--local-only" skips checks needing TIRA
  // server authentication, which aren't available/needed here).
  "postStartCommand": "mkdir -p \"$TIRA_CACHE_DIR\" && pip install --no-deps -e . && tira-cli verify-installation --local-only",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
