{
  "name": "approval-tests-ir-datasets",
  "image": "ghcr.io/ir-datasets/approval-tests-ir-datasets:0.0.1-dev",
  "workspaceFolder": "/workspaces/approval-tests-ir-datasets",
  // The Docker socket is bind-mounted in so PyTerrierIndexVerifier's
  // "tira-cli run local" can start sibling containers on the host. This
  // only works out of the box when the Docker engine shares the same
  // filesystem as this container's workspace mount (true in CI and on
  // plain Linux Docker hosts opened with a matching bind mount) -- NOT the
  // default with e.g. Docker Desktop, where "/workspaces/..." has no host
  // equivalent. See PyTerrierIndexVerifier's docstring for how to point it
  // at a host-visible scratch directory in that case.
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postStartCommand": "pip install --no-deps -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
